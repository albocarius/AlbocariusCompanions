<Project Sdk="Microsoft.NET.Sdk">

  <!-- Authoring CLI (validate, mermaid). net8.0 per SPEC_BEHAVIOR_FOUNDATION I6; RollForward lets it run on a newer runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Core keeps Newtonsoft private (PrivateAssets=all, so it never reaches dist); the CLI runs outside the game and needs
       its own copy at runtime. Same version as Core (orchestra/PLAN.md "Decisions already fixed"). -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AlbocariusCompanions.Core\AlbocariusCompanions.Core.csproj" />
  </ItemGroup>

</Project>
