# Project-specific settings. Sourced by every orchestra script.
# Anything exported here is visible to the worker too (e.g. QT_QPA_PLATFORM).

# Local model server (Strata, Anthropic-compatible endpoint)
STRATA_URL="http://127.0.0.1:8080"
STRATA_KEY="$STRATA_API_KEY"
STRATA_MODEL=""            # empty = server default

# Which harness runs the worker: claude | dsh
WORKER_HARNESS="dsh"
# dsh only: profile that runs headless, and an optional overlay with the Strata provider
DSH_PROFILE="headless"
DSH_PATCH=""               # e.g. orchestra/strata.yml (empty = profile's own config)

# Commands the orchestrator and check_worker.sh use
TEST_CMD="dotnet build AlbocariusCompanions.sln && dotnet test AlbocariusCompanions.sln --no-build"
LINT_CMD=""    # empty = no lint step

# Command prefixes the worker may run (space separated). Each becomes Bash(<prefix>:*)
WORKER_BASH="graphify dotnet ilspycmd"

# Tests written by the orchestrator. The worker must never change these.
ACCEPTANCE_DIR="tests/AlbocariusCompanions.Acceptance"
# Paths the worker must not touch (space separated). Violations fail the attempt.
PROTECTED_PATHS="$ACCEPTANCE_DIR orchestra/ SPEC.md decomp"

WORKER_TIMEOUT="60m"
WAIT_SECONDS=480

# Code graph via graphify CLI (pipx install graphifyy). Code only, local, no tokens.
GRAPHIFY=1
GRAPH_BUDGET=1500          # max tokens per graph query

# Stop after writing PLAN.md and wait for the user's approval (1 = yes)
PLAN_GATE=1

export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_NOLOGO=1
# Worker sandbox leaves MSBuild nodes behind; reusing them from outside crashed the CLR (0x80131506).
export MSBUILDDISABLENODEREUSE=1
export DOTNET_CLI_USE_MSBUILD_SERVER=0

# Example extra environment for the worker:
# export QT_QPA_PLATFORM=offscreen
